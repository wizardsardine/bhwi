{
  "version": 1,
  "rules": [
    {
      "regexp": "Reject",
      "actions": [
        [ "button", 1, true ],
        [ "button", 2, true ],
        [ "button", 2, false ],
        [ "button", 1, false ]
      ]
    },
    {
      "regexp": "Review|From|To|Amount|Address|Fees|Fee|Output|Transaction|Account|Security risk|Unverified inputs|Accept|Approve|Sign|Continue anyway",
      "actions": [
        ["button", 2, true],
        ["button", 2, false]
      ]
    }
  ]
}
